    "react-dom": "19.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.1",
    "@vyaya/mock-deskid": "workspace:*",
    "tailwindcss": "4.3.3",
